{
  "name": "drl-csic",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  // Use the host's NVIDIA GPU when available (requires the NVIDIA Container Toolkit); otherwise run on CPU
  "hostRequirements": {
    "gpu": "optional"
  },

  "postCreateCommand": "pip install --user -r requirements.txt",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  }
}
